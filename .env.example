# 프론트엔드 환경변수 설정

# API 서버 URL
PUBLIC_API_BASE_URL=http://localhost:3001/api

# reCAPTCHA 사이트 키 (선택사항)
PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# 작업증명 챌린지 서버
PUBLIC_HASHGUARD_URL=https://hashguard.viento.me

# Cloudflare Under Attack 감지 시 자동 페이지 리로드 활성화 (true/false)
PUBLIC_CF_UNDER_ATTACK_RELOAD_ENABLED=false

# 의미 검색 활성화 (보드의 검색 방식 컨트롤, /notices/semantic-search 진입점·라우트)
# true, 1, yes, on 중 하나면 활성화. 미설정이면 꺼진 상태로 동작한다.
PUBLIC_SEMANTIC_SEARCH_ENABLED=true

# Google Tag Manager 컨테이너 ID (빌드 타임 주입: `$env/static/public`, 공식 gtm.js 스니펫)
# 빌드 시점에 baked되므로 값을 바꾸면 재빌드가 필요하다.
# 미설정이면 GTM 로딩과 페이지뷰 전송이 모두 생략된다.
# GTM 컨테이너도 게시(Publish)되어야 하며, SPA 페이지뷰는 `virtual_pageview`
# Custom Event 트리거 + GA4 Event(`page_view`) 태그가 받아야 집계된다.
PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX
