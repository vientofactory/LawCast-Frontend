{
	"name": "lawcast-frontend",
	"version": "2.3.1",
	"description": "",
	"author": "vientorepublic",
	"private": true,
	"engines": {
		"node": "^22.23.4 || ^24.22.1 || ^26.12.1"
	},
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:node": "SVELTE_ADAPTER=node vite build",
		"start:node": "node --env-file-if-exists=.env build/index.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:native && npm run test:vendor",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --write . && eslint . --fix",
		"audit:lighthouse": "node scripts/lighthouse-audit.mjs",
		"test:e2e:web-vitals": "playwright test --config playwright-configs/playwright.web-vitals.config.ts",
		"test:e2e:pwa:cloudflare": "PWA_CLOUDFLARE=1 playwright test --config playwright-configs/playwright.pwa.config.ts",
		"test:e2e:pwa": "playwright test --config playwright-configs/playwright.pwa.config.ts",
		"test:e2e": "playwright test --config playwright-configs/playwright.config.ts && playwright test --config playwright-configs/playwright.analytics.config.ts",
		"test:e2e:integration": "playwright test --config playwright-configs/playwright.config.integration.ts",
		"test:e2e:rate-limit": "E2E_RATE_LIMIT_SIM=1 playwright test --config playwright-configs/playwright.rate-limit.config.ts",
		"test:e2e:ip-forwarding": "E2E_IP_ECHO=1 playwright test --config playwright-configs/playwright.ip-forwarding.config.ts",
		"test:e2e:dark-mode": "playwright test --config playwright-configs/playwright.dark-mode.config.ts",
		"test:e2e:cloudflare-challenge": "DIFFCHAIN_UI_MOCK=1 E2E_CF_CHALLENGE=1 playwright test --config playwright-configs/playwright.cloudflare-challenge.config.ts",
		"test:e2e:nsm-degraded": "DIFFCHAIN_UI_MOCK=1 E2E_NSM_DEGRADED=1 playwright test --config playwright-configs/playwright.nsm-degraded.config.ts",
		"test:e2e:semantic-search": "E2E_SEMANTIC_SEARCH=1 playwright test --config playwright-configs/playwright.semantic-search.config.ts",
		"test:e2e:ui": "playwright test --config playwright-configs/playwright.config.ts --ui",
		"test:e2e:debug": "DIFFCHAIN_UI_MOCK=0 playwright test --config playwright-configs/playwright.config.ts --debug",
		"test:e2e:report": "playwright show-report",
		"check:native": "node node_modules/typescript-native/bin/tsc --noEmit",
		"test:vendor": "node --test vendor/deepmerge/security.test.cjs",
		"test:e2e:framework:cloudflare": "DIFFCHAIN_UI_MOCK=1 playwright test --config playwright-configs/playwright.framework-cloudflare.config.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vientofactory/Lawcast-Frontend.git"
	},
	"bugs": {
		"url": "https://github.com/vientofactory/Lawcast-Frontend/issues"
	},
	"homepage": "https://github.com/vientofactory/Lawcast-Frontend#readme",
	"dependencies": {
		"@cf-wasm/resvg": "^0.4.0",
		"@cf-wasm/satori": "^0.4.2",
		"@fortawesome/fontawesome-svg-core": "^7.3.1",
		"@fortawesome/free-brands-svg-icons": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@fortawesome/svelte-fontawesome": "^0.2.4",
		"@types/nprogress": "^0.2.3",
		"axios": "^1.21.0",
		"chart.js": "^4.6.1",
		"chartjs-adapter-date-fns": "^3.0.0",
		"date-fns": "^4.4.0",
		"hashguard-client": "^1.5.2",
		"marked": "^18.1.3",
		"nprogress": "^0.2.0",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"harfbuzz-upstream": "npm:harfbuzzjs@0.10.0",
		"harfbuzzjs": "file:./vendor/harfbuzz-edge"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"chrome-launcher": "^1.2.3",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"lighthouse": "^13.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"wrangler": "^4.158.0",
		"typescript-native": "npm:typescript@^7.0.2",
		"deepmerge": "file:./vendor/deepmerge"
	},
	"overrides": {
		"glob": "^14.0.4",
		"minimatch": "^11.0.5",
		"satori": "^0.33.5",
		"deepmerge": "$deepmerge",
		"harfbuzzjs": "$harfbuzzjs",
		"fflate@<0.7.5": "^0.7.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
