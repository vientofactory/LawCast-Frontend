#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
check_source() {
	if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
		printf '%s\n' 'Commit blocked: stage the complete source before the full Playwright gate.' >&2
		exit 1
	fi
}
check_source
validated_tree=$(git write-tree)
if ! npm run test:e2e:all; then
	printf '%s\n' 'Commit blocked: fix the failing Playwright suite and rerun the entire matrix.' >&2
	exit 1
fi
check_source
if [ "$(git write-tree)" != "$validated_tree" ]; then
	printf '%s\n' 'Commit blocked: the staged source changed during Playwright validation.' >&2
	exit 1
fi
